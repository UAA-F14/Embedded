
(rules PCB freerouting.dsn
  (snapAngle 
    fortyfive_degree
  )
  (rule
    (width 200.0)
    (clearance 200.0)
    (clearance 100.0 (type smd_to_turn_gap))
    (clearance 50.0 (type smd))
    (clearance 500.0 (type "board_edge"))
  )
  (padstack "Via[0-1]_600:300_um"
    (shape
      (circle F.Cu 600.0 0.0 0.0)
    )
    (shape
      (circle B.Cu 600.0 0.0 0.0)
    )
    (attach off)
  )
  (via 
    "Via[0-1]_600:300_um" "Via[0-1]_600:300_um" default
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (viaRule
    default "Via[0-1]_600:300_um"
  )
  (class default
    /PB2 /PD0 /PB3 /PD1 /PB4 /PD2 /PB5 /PD3
    /PL4 /PD4 /PL5 /PD5 /PL6 /PD6 /PL7 /PD7
    GND /PL8 /PE12 /PL9 /PD23 /PL12 /PK24 /PL13
    /PK25 /PE1 /PE3 /PE2 /PE4 +3.3V +5V
    (clearance_class default)
    (via_rule default)
    (rule
      (width 200.0)
    )
    (circuit 
      (use_layer F.Cu B.Cu)
    )
  )
)